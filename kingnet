def cmd_mission(args):
    s = load_state()
    if args.action == "claim":
        if args.id not in MISSIONS:
            err(f"Unknown mission '{args.id}'. See `kingnet missions`.")
            return
        if s["missions"].get(args.id):
            warn("Already claimed.")
            return
        complete_mission(s, args.id)
        save_state(s)


