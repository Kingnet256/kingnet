def _strip_block(text):
    out, skip = [], False
    for line in text.splitlines():
        if line.strip() == HOSTS_BEGIN:
            skip = True; continue
        if line.strip() == HOSTS_END:
            skip = False; continue
        if not skip:
            out.append(line)
    return "\n".join(out)


def _write_hosts(new_text):
    STATE_DIR.mkdir(exist_ok=True)
    tmp = STATE_DIR / "hosts.new"
    tmp.write_text(new_text)
    if DRY:
        say(col(f"  [dry-run] sudo cp {tmp} {HOSTS_PATH}", "d"))
        return True
    if os.name == "nt":
        err(f"On Windows, edit the hosts file manually: {HOSTS_PATH}. I wrote the desired file to {tmp}.")
        return False
    try:
        Path(HOSTS_PATH).write_text(new_text)  # already root?
        return True
    except PermissionError:
        warn(f"Updating {HOSTS_PATH} needs sudo — you may be prompted for your password.")
        r = subprocess.run(["sudo", "cp", str(tmp), HOSTS_PATH])
        if r.returncode != 0:
            err("Could not update the hosts file (sudo failed or declined).")
            return False
        return True


