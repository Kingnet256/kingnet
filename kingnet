def _build_images():
    say("Building lab images (first run only, may take a few minutes)…")
    docker("network", "create", NETWORK, check=False)
    for slug, o in ORGS.items():
        docker("build", "-q", "-t", o["image"], str(ROOT / "targets" / slug))
        ok(f"image {o['image']}")
    docker("build", "-q", "-t", "kingnet/proxy", str(ROOT / "proxy"))
    docker("build", "-q", "-t", "kingnet/console", str(ROOT / "console"))
    ok("images kingnet/proxy, kingnet/console")


def cmd_up(args):
    banner()
    if not have_docker() and not DRY:
        err("Docker is required. Run `kingnet doctor`.")
        sys.exit(2)
    _build_images()
    if not container_running(CONSOLE_NAME):
        (STATE_DIR / "console-data").mkdir(parents=True, exist_ok=True)
        docker("run", "-d", "--name", CONSOLE_NAME, "--network", NETWORK,
               "-p", f"127.0.0.1:{CONSOLE_PORT}:8080",
               "-v", f"{STATE_DIR / 'console-data'}:/app/data", "kingnet/console")
    ok(f"attacker console up → {col(f'http://localhost:{CONSOLE_PORT}/', 'b')}")
    say(f"\nNext: {col('kingnet market', 'c')} to see what you can buy, "
        f"or {col('kingnet tutorial', 'c')} for a guided run.")


