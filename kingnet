def cmd_setup(args):
    banner()
    if have_docker():
        ok("Docker is already installed.")
        if "Server Version" not in docker("info", capture=True, check=False):
            say("  Start it:  sudo systemctl start docker")
        say(f"\n  Next:  {col(PROG + ' up', 'c')}")
        return
    cmds = _docker_install_cmds()
    if not cmds:
        err("Automatic install isn't supported on this OS.")
        say(f"  Get Docker Desktop: {col('https://docs.docker.com/get-docker/', 'b')}")
        return
    say("\n  Installing Docker (you'll be asked for your sudo password):\n")
    for c in cmds:
        say("    " + col(c, "d"))
    if DRY:
        return
    for c in cmds:
        if subprocess.run(c, shell=True).returncode != 0:
            err(f"Step failed: {c}")
            return
    ok("Docker installed.")
    say(col("\n  IMPORTANT: log out and back in (or run `newgrp docker`) so Docker works without sudo.", "y"))
    say(f"  Then:  {col(PROG + ' up', 'c')}")


def _build_images():
    say("Building lab images (first run only, may take a few minutes)…")
    docker("network", "create", NETWORK, check=False)
    for slug, o in ORGS.items():
        docker("build", "-q", "-t", o["image"], str(ROOT / "targets" / slug))
        ok(f"image {o['image']}")
    docker("build", "-q", "-t", "kingnet/proxy", str(ROOT / "proxy"))
    docker("build", "-q", "-t", "kingnet/console", str(ROOT / "console"))
    docker("build", "-q", "-t", ROUTER_IMAGE, str(ROOT / "router"))
    ok("images kingnet/proxy, kingnet/console, kingnet/router")


def cmd_up(args):
    banner()
    if not DRY:
        st = _docker_status()
        if st != "ok":
            _docker_help(st)
            sys.exit(2)
    _build_images()
    if not container_running(CONSOLE_NAME):
        (STATE_DIR / "console-data").mkdir(parents=True, exist_ok=True)
        docker("run", "-d", "--name", CONSOLE_NAME, "--network", NETWORK,
               "--network-alias", CONSOLE_DOMAIN,
               "-p", f"127.0.0.1:{CONSOLE_PORT}:8080",
               "-v", f"{STATE_DIR / 'console-data'}:/app/data", "kingnet/console")
    if not container_running(ROUTER_NAME):
        docker("run", "-d", "--name", ROUTER_NAME, "--network", NETWORK,
               "-p", f"127.0.0.1:{HTTP_PORT}:8080", ROUTER_IMAGE)
    ok(f"attacker console up → {col(f'http://localhost:{CONSOLE_PORT}/', 'b')} "
       f"(also {col(web_url(CONSOLE_DOMAIN), 'b')})")
    ok(f"lab router up → serves every *.kingnet.lab domain on port {HTTP_PORT}")
    # resume orgs/campaigns from a previous session that are stopped (e.g. after a reboot)
    s = load_state()
    to_resume = [o["container"] for o in s["orgs"].values()]
    to_resume += [c["container"] for c in s["campaigns"].values() if c.get("running")]
    resumed = 0
    for name in to_resume:
        if not container_running(name):
            docker("start", name, check=False)
            if container_running(name):
                resumed += 1
    if resumed:
        ok(f"resumed {resumed} of your saved org/campaign container(s)")
    say(f"\nMap the lab domains into your browser once:  {col(PROG + ' hosts install', 'c')}  (uses sudo)")
    say(f"Then: {col('kingnet market', 'c')} to see what you can buy, "
        f"or {col('kingnet tutorial', 'c')} for a guided run.")


