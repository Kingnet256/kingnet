def _header():
    wm = _WORDMARK
    crest = _CREST
    n = max(len(crest), len(wm))
    ct = (n - len(crest)) // 2
    wt = (n - len(wm)) // 2
    crest = [""] * ct + crest + [""] * (n - len(crest) - ct)
    wm = [""] * wt + wm + [""] * (n - len(wm) - wt)
    cw = max(len(r) for r in _CREST)
    red = _RED if C["0"] else ""
    cyan = "\033[1;36m" if C["0"] else ""
    rst = "\033[0m" if C["0"] else ""
    out = []
    for i in range(n):
        out.append("  " + red + crest[i].ljust(cw) + rst + "   " + cyan + wm[i] + rst)
    return "\n".join(out)


def _rule(w=62):
    return col("  " + "─" * w, "line") if "line" in C else "  " + "─" * w


def _console_banner(s, sm):
    out = [_header(),
           col("   adversary-in-the-middle · phishing operator console · LAB ONLY", "d"), ""]
    lab = col("● LAB LIVE", "g") if sm else col("● LAB OFFLINE", "r") + col("  — type ", "d") + col("up", "c")
    nlures = len([c for c in s["campaigns"].values() if c.get("running")])
    loot = (f"{col(sm['cookies'], 'g')}🍪  {col(sm['credentials'], 'y')}🔑  "
            f"{col(sm.get('webauthn_rejected', 0), 'r')}🛡" if sm else col("—", "d"))
    bar = col("  ╭" + "─" * 60, "b")
    end = col("  ╰" + "─" * 60, "b")
    B = col("  │ ", "b")
    out += [bar,
            B + f"{lab}     level {col(level_of(s.get('xp', 0)), 'm')}     {coin(s['coins'])}",
            B + f"orgs {col(len(s['orgs']), 'c')}   ·   lures {col(nlures, 'c')}   ·   loot {loot}",
            B + col("help", "c") + col(" · ", "d") + col("sessions follow", "c")
              + col(" (live feed) · ", "d") + col("lures", "c") + col(" · ", "d") + col("exit", "c"),
            end, ""]
    return "\n".join(out)


