            "  kingnet sessions   → then hijack from the console\n  kingnet defend acme.kingnet.lab --step-up on",
}


def build_parser():
    p = argparse.ArgumentParser(
        prog="kingnet", add_help=True,
        description="KINGNET — lab-contained AiTM/phishing world (local, Docker, lab-only).",
        epilog="Run `kingnet help` for topics, or `kingnet <command> --help` for any command.")
    p.add_argument("--dry-run", action="store_true", help="print the docker commands instead of running them")
    sub = p.add_subparsers(dest="cmd")

    def add(name, fn, help_):
        sp = sub.add_parser(name, help=help_, description=help_)
        sp.set_defaults(func=fn)
        return sp

    add("doctor", cmd_doctor, "check prerequisites (Python, Docker)")
    add("up", cmd_up, "build images + start the base lab (attacker console)")
    add("down", cmd_down, "stop all KINGNET containers (keeps your world state)")
    add("status", cmd_status, "show wallet, orgs and campaigns at a glance")
    add("world", cmd_world, "live dashboard: operator level, orgs, campaigns and loot")
    add("wallet", cmd_wallet, "show your KingCoins balance and recent transactions")
    add("market", cmd_market, "browse the marketplace of target orgs you can buy")

    b = add("buy", cmd_buy, "buy a target org and give it a lab domain")
    b.add_argument("item", help="what to buy (kingmail | kingbank | kingvault)")
    b.add_argument("--domain", help="the lab domain to host it on, e.g. acme-mail.kingnet.lab")

    add("targets", cmd_targets, "list the target orgs you own")

    hs = add("hosts", cmd_hosts, "map your lab domains into /etc/hosts so they open in the browser")
    hsub = hs.add_subparsers(dest="hosts_cmd")
    hsub.add_parser("install", help="add/update the managed block of lab domains (uses sudo)")
    hsub.add_parser("uninstall", help="remove the managed block of lab domains (uses sudo)")
    hsub.add_parser("show", help="list your lab domains and whether the block is installed")

    ph = add("phish", cmd_phish, "run a phishing (AiTM) campaign against a target")
    phs = ph.add_subparsers(dest="phish_cmd")
    pst = phs.add_parser("start", help="start a campaign against --target <domain>")
    pst.add_argument("--target", help="a domain you own (see `kingnet targets`)")
    pst.add_argument("--phish-domain", help="look-alike phishing domain (default login-<org>.kingnet.lab)")
    pstp = phs.add_parser("stop", help="stop a running campaign by id")
    pstp.add_argument("id", help="campaign id (see `kingnet status`)")

    add("sessions", cmd_sessions, "show what your campaigns have captured")

    hj = add("hijack", cmd_hijack, "replay a stolen session to take over an account")
    hj.add_argument("track", help="the victim track id (from the console)")

    df = add("defend", cmd_defend, "turn on a defense for one of your orgs")
    df.add_argument("target", help="a domain you own")
    df.add_argument("--control", choices=["step-up", "device-binding", "xss-safe", "consent-policy"],
                    help="which defense (depends on org type)")
    df.add_argument("state", nargs="?", default="on", choices=["on", "off"], help="on (default) or off")

    add("missions", cmd_missions, "list missions and their KingCoin rewards")
    mi = add("mission", cmd_mission, "claim a mission reward")
    mi.add_argument("action", choices=["claim"])
    mi.add_argument("id", help="mission id (see `kingnet missions`)")

    add("tutorial", cmd_tutorial, "a guided first campaign, step by step")
    rs = add("reset", cmd_reset, "wipe your world and start over")
    rs.add_argument("--yes", action="store_true", help="confirm the reset")

    hp = add("help", cmd_help, "help on commands and topics")
    hp.add_argument("topic", nargs="?", help="a command name or topic (overview, economy, flow)")
    return p


def cmd_help(args):
    topic = getattr(args, "topic", None)
    parser = build_parser()
    if not topic:
        banner()
        say("\n  " + col("COMMANDS", "B"))
        groups = [("Set up", ["doctor", "up", "down", "status", "world", "hosts"]),
                  ("Economy", ["wallet", "market", "buy", "missions", "mission"]),
                  ("Attack", ["targets", "phish", "sessions", "hijack"]),
                  ("Defend / learn", ["defend", "tutorial"]),
                  ("Admin", ["reset", "help"])]
        acts = {a.dest: a for a in parser._subparsers._group_actions} if False else None
        # pull help strings from the subparser choices
        choices = parser._subparsers._group_actions[0].choices
        for gname, cmds in groups:
            say("\n  " + col(gname, "c"))
            for c in cmds:
                h = choices[c].description or ""
                say(f"    {c:<10} {col(h, 'd')}")
        say("\n  Topics: " + ", ".join(TOPICS) + f"   →  {col('kingnet help <topic>', 'c')}")
        say(f"  Detail: {col('kingnet <command> --help', 'c')}")
        return
    if topic in TOPICS:
        banner(); say("\n  " + col(topic.upper(), "B") + "\n\n  " + TOPICS[topic].replace("\n", "\n  "))
        return
    choices = parser._subparsers._group_actions[0].choices
    if topic in choices:
        choices[topic].print_help()
        return
    err(f"No help for '{topic}'. Try `kingnet help` or a topic: {', '.join(TOPICS)}.")


def main(argv=None):
    global DRY
    parser = build_parser()
    args = parser.parse_args(argv)
    DRY = getattr(args, "dry_run", False)
    if not getattr(args, "cmd", None):
        cmd_help(argparse.Namespace(topic=None))
        return
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        say("\naborted.")
