def cmd_hijack(args):
    status, data = http(f"http://localhost:{CONSOLE_PORT}/hijack/{args.track}")
    if status == 200 and isinstance(data, str) and ("Signed in as" in data or "Wire approval" in data):
        ok("Session hijacked — opened the victim's account with no password and no 2FA.")
        s = load_state(); complete_mission(s, "account-takeover"); save_state(s)
    else:
        warn("Could not hijack that track (need a captured session cookie). "
             "Open the console to pick a victim: http://localhost:%d/" % CONSOLE_PORT)


def cmd_defend(args):
    s = load_state()
    dom = _norm_domain(args.target or "")
    if not dom or dom not in s["orgs"]:
        err("Unknown target. See `kingnet targets`.")
        return
    o = s["orgs"][dom]; port = o["port"]; otype = o["type"]
    base = f"http://localhost:{port}"
    want = (args.state != "off")
    if otype == "kingmail":
        ep, payload = ("/admin/bind-policy", {"bind": want}) if args.control == "device-binding" \
            else ("/admin/xss-safe", {"safe": want}) if args.control == "xss-safe" \
            else ("/admin/consent-policy", {"block_unverified": want})
    elif otype == "kingbank":
        ep, payload = "/admin/policy", {"require_step_up": want}
    else:
        warn("KingVault is phishing-resistant by design — no toggle needed.")
        return
    st, resp = http(base + ep, method="POST", data=payload)
    (ok if st == 200 else err)(f"{otype} {dom}: {args.control or 'policy'} → {'ON' if want else 'OFF'}  ({resp})")


