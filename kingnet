def default_state():
    return {"coins": START_COINS, "xp": 0, "ledger": [], "orgs": {}, "campaigns": {},
            "missions": {}, "contracts": [], "defenses_used": [],
            "next_port": 8081, "next_pport": 8443, "created": time.time()}


def level_of(xp):
    return 1 + xp // 250


def award_xp(s, n):
    s["xp"] = s.get("xp", 0) + n


def load_state():
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except Exception:
            warn("world state was corrupt; starting fresh")
    return default_state()


def save_state(s):
    STATE_DIR.mkdir(exist_ok=True)
    STATE_FILE.write_text(json.dumps(s, indent=2))


def spend(s, amount, memo):
    if s["coins"] < amount:
        err(f"Not enough KingCoins: need {coin(amount)}, have {coin(s['coins'])}. "
            f"Earn more — see {col('kingnet missions', 'c')}.")
        return False
    s["coins"] -= amount
    s["ledger"].insert(0, {"ts": time.time(), "delta": -amount, "memo": memo})
    return True


def earn(s, amount, memo):
    s["coins"] += amount
    s["ledger"].insert(0, {"ts": time.time(), "delta": amount, "memo": memo})


def complete_mission(s, key):
    if key in MISSIONS and not s["missions"].get(key):
        s["missions"][key] = time.time()
        title, reward = MISSIONS[key]
        earn(s, reward, f"mission: {title}")
        before = level_of(s.get("xp", 0))
        award_xp(s, reward)
        print(col(f"\n🏅 Mission complete — {title}  +{reward} KC  +{reward} XP", "g"))
        if level_of(s["xp"]) > before:
            print(col(f"⭐ Level up! You are now level {level_of(s['xp'])}.", "m"))


def _unlocked(s, slug):
    u = UNLOCK.get(slug)
    return u is None or u in s.get("contracts", [])


def _bank_fraud_detected(s):
    """True if any KingBank org is showing a fraud alert (a stolen-session drain happened)."""
    for dom, o in s.get("orgs", {}).items():
        if o.get("type") != "kingbank" or not container_running(o["container"]):
            continue
        st, body = http(f"http://localhost:{o['port']}/security")
        if st == 200 and isinstance(body, str) and ("suspicious payment" in body.lower() or "new payee" in body.lower()):
            return True
    return False


def _contract_satisfied(s, cid, sm):
    if cid == "recon":
        return bool(sm) and sm.get("cookies", 0) >= 1
    if cid == "takeover":
        return "account-takeover" in s.get("missions", {})
    if cid == "heist":
        return _bank_fraud_detected(s)
    if cid == "the-wall":
        return bool(sm) and sm.get("webauthn_rejected", 0) >= 1
    if cid == "blue-team":
        return len(s.get("defenses_used", [])) > 0
    return False


def _check_contracts(s, sm="__none__"):
    """Auto-complete any newly-satisfied contracts; award coins + XP. Returns new ids."""
    if sm == "__none__":
        sm = _console_summary()
    newly = []
    for cid, title, _brief, _obj, reward in CONTRACTS:
        if cid in s.get("contracts", []):
            continue
        if _contract_satisfied(s, cid, sm):
            s.setdefault("contracts", []).append(cid)
            earn(s, reward, f"contract: {title}")
            before = level_of(s.get("xp", 0))
            award_xp(s, reward)
            print(col(f"\n📜 Contract complete — {title}  +{reward} KC  +{reward} XP", "g"))
            if level_of(s["xp"]) > before:
                print(col(f"⭐ Level up! You are now level {level_of(s['xp'])}.", "m"))
            if cid == "recon":
                print(col("   Unlocked in the market: KingBank and KingVault.", "c"))
            newly.append(cid)
    return newly


# ---- docker helpers --------------------------------------------------------
DRY = False


def have_docker():
    return shutil.which("docker") is not None


def _docker_status():
    """'missing' | 'nodaemon' | 'noperm' | 'ok'."""
    if not have_docker():
        return "missing"
    try:
        r = subprocess.run(["docker", "info"], capture_output=True, text=True)
    except Exception:
        return "missing"
    if r.returncode == 0:
        return "ok"
    s = (r.stdout + r.stderr).lower()
    if "permission denied" in s:
        return "noperm"
    return "nodaemon"


def _docker_help(status):
    """Print the fix for a not-ready Docker, return True if it printed guidance."""
    if status == "missing":
        err("Docker isn't installed — it's what runs the lab targets.")
        say(f"  Install it in one step:  {col(PROG + ' setup', 'c')}")
        return True
    if status == "nodaemon":
        err("Docker is installed but the daemon isn't running.")
        say("  Start it:  " + col("sudo systemctl start docker", "c"))
        return True
    if status == "noperm":
        user = os.environ.get("USER", "$USER")
        err("Docker is installed but you don't have permission to use it yet.")
        say("  Fix it once (recommended):")
        say("    " + col(f"sudo usermod -aG docker {user}", "c") + "   then log out & back in (or run: " + col("newgrp docker", "c") + ")")
        say("  Or just for now, run kingnet with sudo:  " + col(f"sudo {PROG} up", "c"))
        return True
    return False


def docker(*args, capture=False, check=True):
    cmd = ["docker", *args]
    if DRY:
        say(col("  [dry-run] ", "d") + " ".join(cmd))
        return ""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        if not check:
            return ""
        err("Docker is not installed or not on PATH. Run `kingnet doctor`.")
        sys.exit(2)
    if check and r.returncode != 0:
        err(f"docker {args[0]} failed: {r.stderr.strip() or r.stdout.strip()}")
        sys.exit(1)
    return (r.stdout + r.stderr) if not capture else r.stdout


def container_running(name):
    if DRY or not have_docker():
        return False
    out = docker("ps", "--filter", f"name=^{name}$", "--format", "{{.Names}}", capture=True, check=False)
    return name in out.split()


def http(url, method="GET", data=None, timeout=8):
    try:
        req = urllib.request.Request(url, method=method,
                                     data=json.dumps(data).encode() if data else None,
                                     headers={"Content-Type": "application/json"} if data else {})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read().decode("utf-8", "ignore")
            try:
                return r.status, json.loads(body)
            except Exception:
                return r.status, body
    except Exception as e:
        return None, str(e)


# ---- commands --------------------------------------------------------------
def _docker_install_cmds():
    user = os.environ.get("USER") or os.environ.get("USERNAME") or "$USER"
    if shutil.which("apt-get"):
        return ["sudo apt-get update",
                "sudo apt-get install -y docker.io",
                "sudo systemctl enable --now docker",
                f"sudo usermod -aG docker {user}"]
    if shutil.which("dnf"):
        return ["sudo dnf install -y docker",
                "sudo systemctl enable --now docker", f"sudo usermod -aG docker {user}"]
    if shutil.which("pacman"):
        return ["sudo pacman -S --noconfirm docker",
                "sudo systemctl enable --now docker", f"sudo usermod -aG docker {user}"]
    return None


def cmd_doctor(args):
    banner()
    say("\nChecking prerequisites:")
    pyok = sys.version_info >= (3, 9)
    (ok if pyok else err)(f"Python {sys.version.split()[0]} " + ("(ok)" if pyok else "(need 3.9+)"))
    st = _docker_status()
    if st == "ok":
        ok("Docker is installed and usable: " + docker("--version", capture=True, check=False).strip())
    elif st == "missing":
        err("Docker NOT found — it's what runs the lab targets.")
        cmds = _docker_install_cmds()
        if cmds:
            say(f"      One-step install:  {col(PROG + ' setup', 'c')}")
            say(col("      …or do it manually:", "d"))
            for c in cmds:
                say("        " + c)
        else:
            say(f"      Get Docker Desktop: {col('https://docs.docker.com/get-docker/', 'b')}")
    elif st == "noperm":
        warn("Docker is installed, but you don't have permission yet:")
        say(f"      sudo usermod -aG docker {os.environ.get('USER', '$USER')}   then log out/in (or run: newgrp docker)")
    else:
        warn("Docker is installed, but the daemon isn't running:")
        say("      sudo systemctl start docker")
    on_path = shutil.which("kingnet") is not None
    if on_path:
        ok("CLI is on PATH — you can type `kingnet …` anywhere")
    else:
        warn(f"CLI not on PATH — type `{PROG} …`, or run `{col(PROG + ' install', 'c')}` to use `kingnet` everywhere")
    ok(f"World state: {STATE_FILE}")
    say(f"\nWhen Docker's ready:  {col(PROG + ' up', 'c')}  then  {col(PROG + ' tutorial', 'c')}")


def cmd_install(args):
    src = str(ROOT / "kingnet")
    target = "/usr/local/bin/kingnet"
    if os.name == "nt":
        err("On Windows, add the repo folder to PATH or run it as `python kingnet`.")
        return
    if DRY:
        say(col(f"  [dry-run] sudo ln -sf {src} {target}", "d"))
        return
    try:
        dirn = os.path.dirname(target)
        if os.access(dirn, os.W_OK):
            if os.path.islink(target) or os.path.exists(target):
                os.remove(target)
            os.symlink(src, target)
        else:
            warn(f"Linking into {dirn} needs sudo — you may be prompted.")
            if subprocess.run(["sudo", "ln", "-sf", src, target]).returncode != 0:
                err("Could not create the symlink.")
                return
        ok(f"Installed. You can now run `kingnet …` from anywhere  ({target} → {src}).")
    except Exception as e:
        err(f"Install failed: {e}")


