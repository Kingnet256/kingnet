def _norm_domain(d):
    d = d.strip().lower()
    if not d.endswith(".kingnet.lab"):
        d = d.split(".")[0] + ".kingnet.lab"
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}\.kingnet\.lab", d):
        return None
    return d


def _env_for(slug, domain):
    origin = f"http://localhost"  # overridden per-type below where it matters
    if slug == "kingmail":
        return ["-e", "KINGMAIL_SECRET=kingnet-world"]
    if slug == "kingbank":
        return ["-e", "KINGBANK_SECRET=kingnet-world"]
    if slug == "kingvault":
        return ["-e", "KINGVAULT_RP_ID=localhost"]  # origin set at provision time
    return []


def cmd_buy(args):
    s = load_state()
    slug = args.item
    if slug not in ORGS:
        err(f"Unknown item '{slug}'. See {col('kingnet market', 'c')}.")
        return
    if not args.domain:
        err("Pick a lab domain: --domain <name>.kingnet.lab")
        return
    domain = _norm_domain(args.domain)
    if not domain:
        err("Invalid domain. Use letters/digits/hyphens, e.g. acme-mail.kingnet.lab")
        return
    if domain in s["orgs"]:
        err(f"{domain} already exists in your world.")
        return
    o = ORGS[slug]
    total = o["price"] + DOMAIN_FEE
    if not spend(s, total, f"bought {o['name']} on {domain}"):
        save_state(s)
        return
    port = s["next_port"]; s["next_port"] += 1
    container = "kn-" + domain.replace(".", "-")
    run = ["run", "-d", "--name", container, "--network", NETWORK,
           "--network-alias", domain, "-p", f"127.0.0.1:{port}:8080"]
    if slug == "kingvault":
        # WebAuthn binds to the origin the browser is on — i.e. the lab domain via the router.
        run += ["-e", f"KINGVAULT_ORIGIN={web_url(domain)}", "-e", f"KINGVAULT_RP_ID={domain}"]
    else:
        run += _env_for(slug, domain)
    run += [o["image"]]
    docker(*run)
    s["orgs"][domain] = {"type": slug, "container": container, "port": port, "bought": time.time()}
    award_xp(s, 25)
    if slug == "kingvault":
        complete_mission(s, "defender")
    save_state(s)
    ok(f"Provisioned {col(o['name'], 'B')} at {col(web_url(domain, o['login']), 'b')}")
    say(f"   (also reachable at http://localhost:{port}{o['login']})")
    say(f"   Demo login: {o['creds']}")
    say(f"   Spent {coin(total)}, balance now {coin(s['coins'])}.")
    say(f"   Browse it in your browser after:  {col('kingnet hosts install', 'c')}")
    if slug != "kingvault":
        say(f"\n   Attack it:  {col('kingnet phish start --target ' + domain, 'c')}")
    else:
        say(f"\n   This is the DEFENSE demo — point a phish at it and watch it fail.")


