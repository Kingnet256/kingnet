# ---- world state -----------------------------------------------------------
def default_state():
    return {"coins": START_COINS, "ledger": [], "orgs": {}, "campaigns": {},
            "missions": {}, "next_port": 8081, "next_pport": 8443, "created": time.time()}


def load_state():
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except Exception:
            warn("world state was corrupt; starting fresh")
    return default_state()


def save_state(s):
    STATE_DIR.mkdir(exist_ok=True)
    STATE_FILE.write_text(json.dumps(s, indent=2))


def spend(s, amount, memo):
    if s["coins"] < amount:
        err(f"Not enough KingCoins: need {coin(amount)}, have {coin(s['coins'])}. "
            f"Earn more — see {col('kingnet missions', 'c')}.")
        return False
    s["coins"] -= amount
    s["ledger"].insert(0, {"ts": time.time(), "delta": -amount, "memo": memo})
    return True


def earn(s, amount, memo):
    s["coins"] += amount
    s["ledger"].insert(0, {"ts": time.time(), "delta": amount, "memo": memo})


def complete_mission(s, key):
    if key in MISSIONS and not s["missions"].get(key):
        s["missions"][key] = time.time()
        title, reward = MISSIONS[key]
        earn(s, reward, f"mission: {title}")
        print(col(f"\n🏅 Mission complete — {title}  +{reward} KC", "g"))


# ---- docker helpers --------------------------------------------------------
DRY = False


def have_docker():
    return shutil.which("docker") is not None


def docker(*args, capture=False, check=True):
    cmd = ["docker", *args]
    if DRY:
        say(col("  [dry-run] ", "d") + " ".join(cmd))
        return ""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        if not check:
            return ""
        err("Docker is not installed or not on PATH. Run `kingnet doctor`.")
        sys.exit(2)
    if check and r.returncode != 0:
        err(f"docker {args[0]} failed: {r.stderr.strip() or r.stdout.strip()}")
        sys.exit(1)
    return (r.stdout + r.stderr) if not capture else r.stdout


def container_running(name):
    if DRY or not have_docker():
        return False
    out = docker("ps", "--filter", f"name=^{name}$", "--format", "{{.Names}}", capture=True, check=False)
    return name in out.split()


def http(url, method="GET", data=None, timeout=8):
    try:
        req = urllib.request.Request(url, method=method,
                                     data=json.dumps(data).encode() if data else None,
                                     headers={"Content-Type": "application/json"} if data else {})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read().decode("utf-8", "ignore")
            try:
                return r.status, json.loads(body)
            except Exception:
                return r.status, body
    except Exception as e:
        return None, str(e)


