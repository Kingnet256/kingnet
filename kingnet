def _all_domains(s):
    doms = {CONSOLE_DOMAIN}
    doms.update(s["orgs"].keys())
    for c in s["campaigns"].values():
        if c.get("phish_domain"):
            doms.add(c["phish_domain"])
    return sorted(doms)


def _strip_block(text):
    out, skip = [], False
    for line in text.splitlines():
        if line.strip() == HOSTS_BEGIN:
            skip = True; continue
        if line.strip() == HOSTS_END:
            skip = False; continue
        if not skip:
            out.append(line)
    return "\n".join(out)


def _write_hosts(new_text):
    STATE_DIR.mkdir(exist_ok=True)
    tmp = STATE_DIR / "hosts.new"
    tmp.write_text(new_text)
    if DRY:
        say(col(f"  [dry-run] sudo cp {tmp} {HOSTS_PATH}", "d"))
        return True
    if os.name == "nt":
        err(f"On Windows, edit the hosts file manually: {HOSTS_PATH}. I wrote the desired file to {tmp}.")
        return False
    try:
        Path(HOSTS_PATH).write_text(new_text)  # already root?
        return True
    except PermissionError:
        warn(f"Updating {HOSTS_PATH} needs sudo — you may be prompted for your password.")
        r = subprocess.run(["sudo", "cp", str(tmp), HOSTS_PATH])
        if r.returncode != 0:
            err("Could not update the hosts file (sudo failed or declined).")
            return False
        return True


def cmd_hosts(args):
    s = load_state()
    doms = _all_domains(s)
    sub = getattr(args, "hosts_cmd", None) or "show"
    current = Path(HOSTS_PATH).read_text() if Path(HOSTS_PATH).exists() else ""
    has_block = HOSTS_BEGIN in current
    if sub == "show":
        banner()
        say(f"\n  Lab domains in your world ({len(doms)}):")
        for d in doms:
            say(f"    {col(d, 'c')}  → {web_url(d)}")
        say(f"\n  Managed block in {HOSTS_PATH}: " + (col("present", "g") if has_block else col("absent", "d")))
        if not has_block:
            say(f"  Install it:  {col('kingnet hosts install', 'c')}")
        return
    if sub == "install":
        block = [HOSTS_BEGIN] + [f"127.0.0.1\t{d}" for d in doms] + [HOSTS_END]
        new = _strip_block(current).rstrip("\n") + "\n\n" + "\n".join(block) + "\n"
        if _write_hosts(new):
            ok(f"Mapped {len(doms)} lab domain(s) → 127.0.0.1 in {HOSTS_PATH}.")
            if HTTP_PORT != 80:
                warn(f"The router is on port {HTTP_PORT}, so open domains as http://<name>:{HTTP_PORT}/.")
            else:
                say("  Open them straight in your browser, e.g. " + col(web_url(next(iter(doms))), "b"))
            say(f"  Re-run {col('kingnet hosts install', 'c')} whenever you buy an org or start a campaign.")
    elif sub == "uninstall":
        new = _strip_block(current).rstrip("\n") + "\n"
        if _write_hosts(new):
            ok(f"Removed the KINGNET block from {HOSTS_PATH}.")


def cmd_phish(args):
    s = load_state()
    if args.phish_cmd == "start":
        dom = _norm_domain(args.target or "")
        if not dom or dom not in s["orgs"]:
            err("Unknown target. See `kingnet targets`.")
            return
        o = s["orgs"][dom]
        otype = o["type"]
        if otype == "kingvault":
            warn("KingVault uses passkeys — a phishing proxy cannot steal its login. "
                 "That's the point; run it and watch the relay get rejected.")
        # The phishing site lives on its OWN look-alike lab domain — a DIFFERENT origin from
        # the real org. That difference is exactly why passkeys win and shared secrets lose.
        phish_domain = _norm_domain(args.phish_domain) if getattr(args, "phish_domain", None) \
            else f"login-{dom.split('.')[0]}.kingnet.lab"
        pport = s["next_pport"]; s["next_pport"] += 1
        container = f"kn-phish-{phish_domain.replace('.', '-')}"
        cookie = ORGS[otype]["cookie"] or "none"
        docker("run", "-d", "--name", container, "--network", NETWORK,
               "--network-alias", phish_domain,
               "-e", f"TARGET_URL=http://{dom}:8080",
               "-e", f"PROXY_PUBLIC_URL={web_url(phish_domain)}",
               "-e", f"CONSOLE_URL=http://{CONSOLE_NAME}:8080",
               "-e", f"SESSION_COOKIE_NAME={cookie}",
               "-p", f"127.0.0.1:{pport}:8080", "kingnet/proxy")
        cid = f"camp-{pport}"
        url = web_url(phish_domain, ORGS[otype]["login"])
        s["campaigns"][cid] = {"target": dom, "phish_domain": phish_domain, "container": container,
                               "port": pport, "phish_url": url, "running": True, "started": time.time()}
        award_xp(s, 15)
        complete_mission(s, "first-blood")
        save_state(s)
        ok(f"Campaign {col(cid, 'm')} live — phishing domain {col(phish_domain, 'r')} (vs real {col(dom, 'c')}).")
        say(f"   Send your victim this phishing link:  {col(url, 'b')}")
        say(f"   (also at http://localhost:{pport}{ORGS[otype]['login']})")
        say(f"   Run {col('kingnet hosts install', 'c')} so the domain resolves in your browser.")
        say(f"   Watch captures:  {col('kingnet sessions', 'c')}   console: {web_url(CONSOLE_DOMAIN)}")
    elif args.phish_cmd == "stop":
        c = s["campaigns"].get(args.id)
        if not c:
            err("No such campaign. See `kingnet status`.")
            return
        docker("rm", "-f", c["container"], check=False)
        c["running"] = False
        save_state(s)
        ok(f"Stopped campaign {args.id}.")


