def web_url(domain, path=""):
    port = "" if HTTP_PORT == 80 else f":{HTTP_PORT}"
    return f"http://{domain}{port}{path}"


def _prog_name():
    """How the user invoked us, so copy-paste commands always work.
    'kingnet' if it's on PATH, otherwise the path they typed (e.g. './kingnet')."""
    inv = sys.argv[0] or "kingnet"
    base = os.path.basename(inv)
    if inv == base and shutil.which(base):          # a bare name resolvable on PATH
        return base
    if inv.startswith(("/", "./", "../")):
        return inv
    return "./" + base


