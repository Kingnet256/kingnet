def _phish_self_test(s, args):
    """Drive a victim login THROUGH the phishing proxy from inside the lab, then confirm
    the console captured it. Proves the pipeline works independently of your browser."""
    import http.cookiejar
    import re as _re
    import urllib.parse
    import urllib.request
    banner()
    dom = _norm_domain(args.target) if getattr(args, "target", None) else None
    camps = [c for c in s["campaigns"].values()
             if c.get("running") and (dom is None or c["target"] == dom)]
    if not camps:
        err(f"No running campaign to test. Start one:  {PROG} phish start --target <domain>")
        return
    c = camps[0]; target = c["target"]; o = s["orgs"].get(target)
    if not o:
        err("Campaign target org not found in your world.")
        return
    otype = o["type"]
    if otype == "kingvault":
        warn("KingVault uses passkeys — there is nothing to capture (that's the lesson).")
        return
    creds = {"kingmail": ("victim@kingmail.lab", "Summer2026!"),
             "kingbank": ("victim@kingbank.lab", "Autumn2026!")}[otype]
    base = f"http://localhost:{c['port']}"           # the phishing proxy
    orgbase = f"http://localhost:{o['port']}"        # the real org (for its /phone code)
    say(col(f"\n  Simulating a victim login through {col(c['phish_url'], 'b')} …", "B"))
    cj = http.cookiejar.CookieJar()
    op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))

    def _get(u):
        with op.open(u, timeout=15) as r:
            return r.read().decode("utf-8", "ignore")

    def _post(u, d):
        req = urllib.request.Request(u, data=urllib.parse.urlencode(d).encode())
        with op.open(req, timeout=15) as r:
            return r.read().decode("utf-8", "ignore")

    try:
        _get(base + "/login")
        _post(base + "/login", {"email": creds[0], "password": creds[1]})
        code = _re.search(r"\b(\d{6})\b", _get(orgbase + "/phone"))
        if not code:
            err("Couldn't read the live OTP from the org's /phone page.")
            return
        _post(base + "/otp", {"code": code.group(1)})
    except Exception as e:
        err(f"Simulated login failed (is the campaign + console up?): {e}")
        return
    time.sleep(1.0)
    hit = [x for x in (_captures() or []) if x.get("username") == creds[0]]
    gc = any(x.get("username") for x in hit)
    go = any(x.get("otp") for x in hit)
    gk = any(x.get("cookie") for x in hit)
    (ok if gc else err)("credentials captured" if gc else "credentials NOT captured")
    (ok if go else err)("2FA code captured" if go else "2FA code NOT captured")
    (ok if gk else err)("session cookie captured" if gk else "session cookie NOT captured")
    if gc and go and gk:
        say(col("\n  ✅ The capture pipeline works in this deployment.", "g"))
        say(f"  If your own browser login captured nothing, you likely used the REAL org URL.")
        say(f"  Use the PHISHING link:  {col(c['phish_url'], 'b')}   (NOT {web_url(target)})")
    else:
        say(col("\n  ✗ Capture is broken in this deployment. Check: is the attacker console running,", "r"))
        say(col("    and can the proxy reach it (CONSOLE_URL)?  Try `kingnet status`.", "r"))


def cmd_phish(args):
    s = load_state()
    if args.phish_cmd == "start":
        dom = _norm_domain(args.target or "")
        if not dom or dom not in s["orgs"]:
            err("Unknown target. See `kingnet targets`.")
            return
        o = s["orgs"][dom]
        otype = o["type"]
        if otype == "kingvault":
            warn("KingVault uses passkeys — a phishing proxy cannot steal its login. "
                 "That's the point; run it and watch the relay get rejected.")
        # The phishing site lives on its OWN look-alike lab domain — a DIFFERENT origin from
        # the real org. That difference is exactly why passkeys win and shared secrets lose.
        phish_domain = _norm_domain(args.phish_domain) if getattr(args, "phish_domain", None) \
            else f"login-{dom.split('.')[0]}.kingnet.lab"
        pport = s["next_pport"]; s["next_pport"] += 1
        container = f"kn-phish-{phish_domain.replace('.', '-')}"
